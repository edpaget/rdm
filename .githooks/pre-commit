#!/usr/bin/env bash
# Pre-commit gate is owned by hk (see hk.pkl): cargo fmt/clippy/nextest plus
# shellcheck + shfmt, scoped to staged files. post-commit / post-merge are the
# rdm `Done:`-convention dogfooding hooks and are intentionally left untouched.
set -e

if ! command -v hk >/dev/null 2>&1; then
    echo "error: 'hk' not found on PATH — the pre-commit gate needs it." >&2
    echo "       Run 'mise install' to provision hk (and the rest of the toolchain)." >&2
    exit 1
fi

exec hk run pre-commit
